            "type": "object",
            "properties": {
                "pending_menu_requests": {
                    "type": "integer"
                },
                "pending_supply_requests": {
                    "type": "integer"
                }
            }
        },
        "reports.AttendanceReportResponse": {
            "type": "object",
            "properties": {
                "absent": {
                    "type": "integer"
                },
                "present": {
                    "type": "integer"
                },
                "total_employees": {
                    "type": "integer"
                },
                "total_overtime": {
                    "type": "number"
                }
            }
        },
        "reports.AuditLogResponse": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string"
                },
                "actor_id": {
                    "type": "string"
                },
                "actor_role": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "entity_id": {
                    "type": "string"
                },
                "entity_type": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                }
            }
        },
        "reports.InventoryReportResponse": {
            "type": "object",
            "properties": {
                "low_stock_items": {
                    "type": "integer"
                },
                "total_items": {
                    "type": "integer"
                },
                "total_value": {
                    "type": "number"
                }
            }
        },
        "reports.SalesReportResponse": {
            "type": "object",
            "properties": {
                "average_order": {
                    "type": "number"
                },
                "delivery_sales": {
                    "type": "number"
                },
                "restaurant_sales": {
                    "type": "number"
                },
                "total_orders": {
                    "type": "integer"
                },
                "total_revenue": {
                    "type": "number"
                }
            }
        }
    }
}