 import '../../../../core/network/authenticated_api.dart';
+import '../../../employees/domain/entities/employee.dart';
+import '../../domain/entities/attendance_record.dart';
 
 class ApiAttendanceRepository {
   ApiAttendanceRepository(this.api);
 
   final AuthenticatedApi api;
 
+  Future<AttendanceRecord> getRecord({
+    required Employee employee,
+    required DateTime workDate,
+  }) async {
+    final query = Uri(
+      queryParameters: {
+        'employee_id': employee.id,
+        'work_date': workDate.toIso8601String().split('T').first,
+      },
+    ).query;
+    final data = await api.get('/api/v1/attendance/records?$query') as Map;
+    final deduction = data['deduction'] as Map?;
+    final delayMinutes = (deduction?['late_minutes'] as num?)?.toInt() ?? 0;
+    final checkOut = data['check_out_at'] as String?;
+
+    return AttendanceRecord(
+      id: data['id'] as String,
+      employeeName: employee.name,
+      employeeCode: employee.code,
+      role: employee.role,
+      workDate: data['work_date'] as String,
+      checkInTime: _localTime(data['check_in_at'] as String),
+      checkOutTime: checkOut == null ? null : _localTime(checkOut),
+      status: delayMinutes > 0
+          ? AttendanceStatus.late
+          : AttendanceStatus.present,
+      deductionId: deduction?['id'] as String?,
+      isDeductionCancelled: deduction?['cancelled'] == true,
+      delayMinutes: delayMinutes,
+      deductionAmount:
+          (deduction?['effective_amount'] as num?)?.toDouble() ?? 0,
+      isDeductionAdjusted:
+          deduction?['adjusted_amount'] != null ||
+          deduction?['cancelled'] == true,
+    );
+  }
+
+  String _localTime(String value) {
+    final local = DateTime.parse(value).toLocal();
+    return '${local.hour.toString().padLeft(2, '0')}:${local.minute.toString().padLeft(2, '0')}';
+  }
+
